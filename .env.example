# ==============================================================================
# HUIT CHATBOT RAG SYSTEM - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Tuyệt đối không commit file .env chứa giá trị thật lên Git repository.
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường của bạn.
# ==============================================================================

# Môi trường chạy ứng dụng: development | staging | production
APP_ENV=development
PORT=8000

# Cấu hình danh sách tên miền CORS được phép (phân tách bởi dấu phẩy)
# Staging: thay bằng URL Vercel ĐÃ XÁC MINH, ví dụ https://<project>.vercel.app.
# Không giữ hostname ví dụ/placeholder khi deploy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Cấu hình MongoDB Atlas (Cơ sở tri thức tuyển sinh HUIT)
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/huit_chatbot?retryWrites=true&w=majority
MONGODB_USER=your_mongodb_username
MONGODB_HOST=your_cluster.mongodb.net
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=huit_chatbot
MONGODB_COLL=huit_kb

# Cấu hình API Keys cho các nhà cung cấp LLM
# 1. Google Gemini API (Khuyến nghị: gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq Cloud API (Dự phòng tốc độ cao)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter API (Dự phòng fallback)
HUIT_OPENROUTER_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Cấu hình tham số RAG
TOP_K=3
LLM_MAX_TOKENS=750
# Đặt false trên container RAM thấp để dùng keyword fallback, tránh OOM khi nạp
# intfloat/multilingual-e5-large. Không làm thay đổi vector 1024D đã lưu trong MongoDB.
ENABLE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Quản trị & Xác thực (BẮT BUỘC đặt chuỗi bí mật ngẫu nhiên mạnh trong production)
ADMIN_USERNAME=admin_huit
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
ADMIN_TOKEN=change_this_to_a_long_random_secret_token_in_production
SIGNATURE_SECRET_KEY=change_this_to_a_64_hex_secret_key_for_hmac_download_signing
CSRF_SECRET_KEY=change_this_to_a_64_hex_secret_key_for_csrf_protection

# Giới hạn tần suất & Bộ nhớ đệm
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_HOURS=24

# ==============================================================================
# HẠ TẦNG PHÂN TÁN CHO MÔI TRƯỜNG PRODUCTION (Clustered / Multi-Instance)
# ==============================================================================

# 1. Object Storage (S3 / Cloudflare R2 / MinIO) - Lưu trữ Binary/Artifacts tách rời.
# Staging/production chạy backend và worker tách service phải dùng s3/r2/minio, không dùng local.
STORAGE_BACKEND=local
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=huit-chatbot-artifacts
STORAGE_REGION=ap-southeast-1
STORAGE_USE_SSL=true

# 2. Redis Authentication (Bắt buộc mật khẩu bảo vệ trên production)
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
RATE_LIMIT_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 3. Durable Background Queue (Hàng đợi nền chống mất việc khi server crash/restart)
QUEUE_PROVIDER=mongo
QUEUE_LEASE_SECONDS=120

# 4. NDJSON Streaming v2 Resume Buffer (Phục hồi stream khi rớt mạng trên cluster)
STREAM_RESUME_REDIS_URL=redis://default:password@your-redis-host:6379/1
