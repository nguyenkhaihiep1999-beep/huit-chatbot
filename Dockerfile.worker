# Dockerfile.worker
# Standalone container for HUIT Chatbot Durable Background Queue Artifact Worker

FROM python:3.11-slim as base

# Ngăn ngừa Python ghi buffer và bytecode
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production

WORKDIR /app

# Cài đặt system dependencies cần thiết (nếu cần font hoặc build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Tạo non-root user để tăng cường bảo mật
RUN groupadd -r appgroup && useradd -r -g appgroup -d /app appuser

# Copy mã nguồn
COPY backend /app/backend
COPY scripts /app/scripts

# Chuẩn bị thư mục dữ liệu và phân quyền
RUN mkdir -p /app/data/artifacts_store && \
    chown -R appuser:appgroup /app

USER appuser

# Healthcheck kiểm tra tiến trình liveness
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import os,time,sys; p='/tmp/huit_worker_heartbeat'; sys.exit(0 if os.path.exists(p) and time.time()-os.path.getmtime(p)<90 else 1)"

# Khởi chạy Worker
CMD ["python", "-m", "backend.app.workers.artifact_worker"]
