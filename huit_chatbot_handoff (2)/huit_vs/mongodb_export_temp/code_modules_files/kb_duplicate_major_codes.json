{
  "_id": "kb_duplicate_major_codes",
  "module_version": "1.0.0",
  "kind": "mongodb_aggregation",
  "enabled": true,
  "description": "Mã ngành có nhiều tên khác nhau",
  "source_collection": "huit_kb",
  "risk_level": "read",
  "allowed_targets": [],
  "parameters": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "public": {
    "node_data": {
      "jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "module_version",
          "kind",
          "enabled",
          "source_collection",
          "risk_level"
        ]
      }
    }
  },
  "private": {
    "node_function": {
      "edge": [
        {
          "purpose": "Mã ngành có nhiều tên khác nhau",
          "pipeline": [
            {
              "$match": {
                "major_code": {
                  "$type": "string",
                  "$ne": ""
                }
              }
            },
            {
              "$group": {
                "_id": "$major_code",
                "titles": {
                  "$addToSet": "$title"
                }
              }
            },
            {
              "$project": {
                "major_code": "$_id",
                "titles": 1,
                "title_count": {
                  "$size": "$titles"
                }
              }
            },
            {
              "$match": {
                "title_count": {
                  "$gt": 1
                }
              }
            },
            {
              "$project": {
                "_id": 0
              }
            }
          ]
        }
      ]
    }
  }
}