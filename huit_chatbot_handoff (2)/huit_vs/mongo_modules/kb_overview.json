{
  "_id": "kb_overview",
  "module_version": "1.0.0",
  "kind": "mongodb_aggregation",
  "enabled": true,
  "description": "Tổng quan kho tri thức",
  "source_collection": "huit_kb",
  "risk_level": "read",
  "allowed_targets": [],
  "parameters": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "public": {
    "node_data": {
      "jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "module_version",
          "kind",
          "enabled",
          "source_collection",
          "risk_level"
        ]
      }
    }
  },
  "private": {
    "node_function": {
      "edge": [
        {
          "purpose": "Tổng quan kho tri thức",
          "pipeline": [
            {
              "$facet": {
                "totals": [
                  {
                    "$count": "documents"
                  }
                ],
                "categories": [
                  {
                    "$group": {
                      "_id": "$category",
                      "count": {
                        "$sum": 1
                      }
                    }
                  },
                  {
                    "$project": {
                      "_id": 0,
                      "category": "$_id",
                      "count": 1
                    }
                  },
                  {
                    "$sort": {
                      "count": -1
                    }
                  },
                  {
                    "$limit": 30
                  }
                ],
                "years": [
                  {
                    "$group": {
                      "_id": "$year",
                      "count": {
                        "$sum": 1
                      }
                    }
                  },
                  {
                    "$project": {
                      "_id": 0,
                      "year": "$_id",
                      "count": 1
                    }
                  },
                  {
                    "$sort": {
                      "count": -1
                    }
                  },
                  {
                    "$limit": 20
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}