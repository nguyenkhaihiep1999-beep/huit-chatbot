{
  "_id": "kb_major_catalog",
  "module_version": "1.0.0",
  "kind": "mongodb_aggregation",
  "enabled": true,
  "description": "Danh mục mã ngành",
  "source_collection": "huit_kb",
  "risk_level": "read",
  "allowed_targets": [],
  "parameters": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "public": {
    "node_data": {
      "jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "module_version",
          "kind",
          "enabled",
          "source_collection",
          "risk_level"
        ]
      }
    }
  },
  "private": {
    "node_function": {
      "edge": [
        {
          "purpose": "Danh mục mã ngành",
          "pipeline": [
            {
              "$match": {
                "major_code": {
                  "$type": "string",
                  "$ne": ""
                }
              }
            },
            {
              "$group": {
                "_id": "$major_code",
                "titles": {
                  "$addToSet": "$title"
                },
                "documents": {
                  "$sum": 1
                }
              }
            },
            {
              "$project": {
                "_id": 0,
                "major_code": "$_id",
                "titles": 1,
                "documents": 1
              }
            },
            {
              "$sort": {
                "major_code": 1
              }
            }
          ]
        }
      ]
    }
  }
}