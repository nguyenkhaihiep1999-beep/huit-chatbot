{
  "_id": "rag_daily_volume",
  "module_version": "1.0.0",
  "kind": "mongodb_aggregation",
  "enabled": true,
  "description": "Lưu lượng RAG theo ngày",
  "source_collection": "rag_events",
  "risk_level": "read",
  "allowed_targets": [],
  "parameters": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "public": {
    "node_data": {
      "jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "module_version",
          "kind",
          "enabled",
          "source_collection",
          "risk_level"
        ]
      }
    }
  },
  "private": {
    "node_function": {
      "edge": [
        {
          "purpose": "Lưu lượng RAG theo ngày",
          "pipeline": [
            {
              "$match": {
                "created_at": {
                  "$type": "date"
                }
              }
            },
            {
              "$group": {
                "_id": {
                  "$dateToString": {
                    "format": "%Y-%m-%d",
                    "date": "$created_at"
                  }
                },
                "requests": {
                  "$sum": 1
                }
              }
            },
            {
              "$project": {
                "_id": 0,
                "day": "$_id",
                "requests": 1
              }
            },
            {
              "$sort": {
                "day": -1
              }
            }
          ]
        }
      ]
    }
  }
}