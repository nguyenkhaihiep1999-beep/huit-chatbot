# ==========================================
# CẤU HÌNH API CHO HUIT CHATBOT (RAG SYSTEM)
# ==========================================

# 1. Mật khẩu MongoDB Atlas (BẮT BUỘC)
MONGODB_PASSWORD=your_new_mongodb_password_here

# Bắt buộc trên production: bảo vệ endpoint sync/cache/metrics.
ADMIN_TOKEN=replace_with_a_long_random_secret

# Giới hạn và phiên bản vận hành.
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_HOURS=24
KB_VERSION=huit-kb-2026-07-v3-verified
ENABLE_DATA_SYNC=false

# 2. Cấu hình LLM API Key (Chọn 1 trong các cách bên dưới)

# --- CÁCH A: Dùng Google Gemini API (Khuyên dùng - Nhanh & Miễn phí) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- CÁCH B: Dùng Qwen chính thức qua Alibaba DashScope ---
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# QWEN_MODEL=qwen-plus

# --- CÁCH C: Dùng Qwen Local Offline qua Ollama (Không cần API key) ---
# OLLAMA_MODEL=qwen2.5
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- CÁCH D: Dùng OpenRouter API ---
# HUIT_OPENROUTER_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# LLM_MAX_TOKENS=350

# --- CÁCH E: Dùng OpenAI API ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
