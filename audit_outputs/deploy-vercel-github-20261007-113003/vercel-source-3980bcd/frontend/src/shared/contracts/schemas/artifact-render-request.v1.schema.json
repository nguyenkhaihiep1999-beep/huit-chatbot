{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:api:artifact-render-request:1.0.0",
  "title": "HUIT artifact render request",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "format": {
      "enum": ["xlsx", "docx", "pdf", "png", "svg", "webp"],
      "default": "svg"
    },
    "quality": {
      "enum": ["preview", "standard", "high", "retina", "4k"],
      "default": "preview"
    },
    "scale": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 }
  }
}
