{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:decision:decision-result:1.0.0",
  "title": "HUIT decision engine result contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_type",
    "status",
    "provider",
    "model",
    "decisions"
  ],
  "properties": {
    "decision_type": {
      "type": "string",
      "enum": [
        "intent",
        "evidence_sufficiency",
        "custom"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "fallback",
        "error",
        "skipped"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "choice",
              "score",
              "noul"
            ]
          },
          "choice": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "noul": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}
