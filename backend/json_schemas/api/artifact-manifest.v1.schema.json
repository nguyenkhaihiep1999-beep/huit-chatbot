{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:api:artifact-manifest:1.0.0",
  "title": "HUIT artifact ultralight JSON manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "type", "template_id", "title", "preview"],
  "properties": {
    "version": { "type": "integer", "default": 1 },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "type": { "enum": ["spreadsheet", "document", "image"] },
    "template_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": {
      "anyOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }],
      "default": null
    },
    "content": { "type": "object", "default": {} },
    "style": { "type": "object", "default": {} },
    "assets": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "preview": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "type": { "type": "string", "default": "svg" },
        "url": { "type": "string" },
        "thumbnail_url": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null
        },
        "width": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null
        },
        "height": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null
        }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pending", "rendering", "ready", "failed"],
          "default": "pending"
        },
        "quality": {
          "enum": ["preview", "standard", "high", "retina", "4k"],
          "default": "preview"
        },
        "scale": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100, "default": 100 },
        "error": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null
        }
      }
    },
    "export_options": {
      "type": "array",
      "items": { "enum": ["xlsx", "docx", "pdf", "png", "svg", "webp"] },
      "default": ["xlsx", "docx", "pdf", "png", "svg"]
    },
    "content_hash": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    },
    "created_at": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    },
    "owner_id": {
      "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }],
      "default": null
    }
  }
}
