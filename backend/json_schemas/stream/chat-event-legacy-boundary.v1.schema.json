{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:stream:chat-event-legacy-boundary:1.0.0",
  "title": "HUIT legacy chat event compatibility boundary",
  "description": "Deprecated input-only compatibility contract. Producers must emit canonical v2 events.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": [
        "stream_started",
        "meta",
        "sources",
        "text_delta",
        "artifact_planned",
        "preview_ready",
        "text_completed",
        "completed",
        "token",
        "start",
        "progress",
        "artifact",
        "error",
        "done",
        "cancelled",
        "heartbeat"
      ]
    },
    "protocol_version": { "type": "integer", "minimum": 1, "maximum": 2 },
    "sequence": { "type": "integer", "minimum": 1 },
    "stream_id": { "type": "string" },
    "request_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
