{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:queue:retry-metadata:1.0.0",
  "title": "HUIT job queue retry and lease metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt", "max_attempts"],
  "properties": {
    "attempt": { "type": "integer", "minimum": 0, "default": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
    "retries": { "type": "integer", "minimum": 0, "default": 0 },
    "lease_owner": {
      "anyOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }],
      "default": null
    },
    "lease_expires_at": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    },
    "heartbeat_at": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    },
    "available_at": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    }
  }
}
