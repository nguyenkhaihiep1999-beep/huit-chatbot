{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huit:schema:queue:job-result:1.0.0",
  "title": "HUIT worker execution result payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": { "type": "string" },
    "download_url": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "default": null
    },
    "media_type": {
      "anyOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }],
      "default": null
    },
    "bytes": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
      "default": null
    },
    "filename": {
      "anyOf": [{ "type": "string", "maxLength": 255 }, { "type": "null" }],
      "default": null
    },
    "scale": {
      "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 4 }, { "type": "null" }],
      "default": null
    },
    "upscaled_id": {
      "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }],
      "default": null
    }
  }
}
